# Docker Compose settings. Copy to .env (git-ignored) next to docker-compose.yml.
# For native development (`docker compose up -d db`) only POSTGRES_* matter; the backend has its own
# socud-backend/.env whose DATABASE_URL must match the values below.
# The sections after POSTGRES_* are used by the full stack: `docker compose --profile app up -d --build`.

# Database user and name (optional, defaults shown).
POSTGRES_USER=dbsocud
POSTGRES_DB=socud_db

# Database password. REQUIRED: `docker compose` refuses to start without it.
#
# WARNING for existing installs: POSTGRES_PASSWORD is only applied when the data volume is first
# initialised. An existing `socud_pgdata` volume keeps the password it was created with. The old
# docker-compose.yml default was `check-socud`, so if you already have data, set
#   POSTGRES_PASSWORD=check-socud
# (or change the password inside the database with ALTER USER and then put the new one here).
# For a fresh install generate one: openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- Full stack (`--profile app`) -------------------------------------------------------------

# Secret for signing access tokens, min 32 chars. REQUIRED for the backend. Generate: openssl rand -hex 32
JWT_SECRET=

# First admin, created by `docker compose --profile app run --rm migrate npx prisma db seed`.
# Password: at least 12 characters, at most 72 bytes. Remove both variables from .env afterwards.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Redis: the backend container uses redis://redis:6379 automatically. A native backend uses
# redis://127.0.0.1:${REDIS_HOST_PORT} (published on loopback only).
# REDIS_HOST_PORT=6379

# Embeddings: EMBEDDING_PROVIDER=worker (default) uses the AI worker below; EMBEDDING_PROVIDER=api uses a hosted
# OpenAI-compatible API such as OpenRouter and needs no worker (README "Using a hosted embedding API (OpenRouter)").
# The text of documents and search queries then leaves your machine.
# EMBEDDING_PROVIDER=api
# EMBEDDING_API_URL=https://openrouter.ai/api/v1
# EMBEDDING_API_KEY=
# EMBEDDING_API_MODEL=qwen/qwen3-embedding-4b
# EMBEDDING_API_DIMENSIONS=1024
# EMBEDDING_API_BATCH_SIZE=32
# EMBEDDING_API_QUERY_INSTRUCTION=
# EMBEDDING_MODEL_ID=
# EMBED_BATCH_SIZE=16        (provider=api; empty = 1 for the worker, 16 for the API)
# EMBED_CONCURRENCY=2

# AI worker: runs natively on the host (MLX needs Apple Silicon), NOT in Docker.
# Containers reach it through host.docker.internal. Keep the worker on HOST=127.0.0.1 (verified with OrbStack).
# To offload embedding to another machine with an NVIDIA GPU, point the URL at it (and set the token below):
# AI_WORKER_URL=http://192.168.1.50:8000      (see README "Running the worker on another machine")
# AI_WORKER_URL=http://host.docker.internal:8000
# Must match the worker's WORKER_TOKEN. Generate: openssl rand -hex 32
# AI_WORKER_TOKEN=
# EMBEDDING_DIM=1024

# Logging and error reporting (optional). LOG_LEVEL: fatal|error|warn|info|debug|trace|silent.
# LOG_LEVEL=info
# SENTRY_DSN=

# URLs the BROWSER uses to reach the backend. Inlined into the frontend bundle at build time:
# rebuild the frontend image (`docker compose --profile app build frontend`) after changing them.
# NEXT_PUBLIC_API_URL=http://localhost:3000
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:3002
# CORS_ORIGIN=http://localhost:3001

# Host ports (all bound to 127.0.0.1). Change if a port is taken; keep NEXT_PUBLIC_*/CORS_ORIGIN in sync.
# POSTGRES_HOST_PORT=5432
# BACKEND_HOST_PORT=3000
# BACKEND_WS_HOST_PORT=3002
# FRONTEND_HOST_PORT=3001
# POSTGRES_CONTAINER_NAME=socud_postgres
# Node major version for the images (keep equal to .nvmrc).
# NODE_VERSION=22
