# Docker Compose settings. Copy to .env (git-ignored) next to docker-compose.yml.
# For native development (`docker compose up -d db`) only POSTGRES_* matter; the backend has its own
# socud-backend/.env whose DATABASE_URL must match the values below.
# The sections after POSTGRES_* are used by the full stack: `docker compose --profile app up -d --build`.

# Database user and name (optional, defaults shown).
POSTGRES_USER=dbsocud
POSTGRES_DB=socud_db

# Database password. REQUIRED: `docker compose` refuses to start without it.
#
# WARNING for existing installs: POSTGRES_PASSWORD is only applied when the data volume is first
# initialised. An existing `socud_pgdata` volume keeps the password it was created with. The old
# docker-compose.yml default was `check-socud`, so if you already have data, set
#   POSTGRES_PASSWORD=check-socud
# (or change the password inside the database with ALTER USER and then put the new one here).
# For a fresh install generate one: openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- Full stack (`--profile app`) -------------------------------------------------------------

# Secret for signing access tokens, min 32 chars. REQUIRED for the backend. Generate: openssl rand -hex 32
JWT_SECRET=

# First admin, created by `docker compose --profile app run --rm migrate npx prisma db seed`.
# Password: at least 12 characters, at most 72 bytes. Remove both variables from .env afterwards.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Redis: the backend container uses redis://redis:6379 automatically. A native backend uses
# redis://127.0.0.1:${REDIS_HOST_PORT} (published on loopback only).
# REDIS_HOST_PORT=6379

# ---- Embeddings: ONE switch ---------------------------------------------------------------------------------------
# EMBEDDING_PROFILE picks one of the blocks below (they all sit here at once; only the selected one is read, the others
# are ignored, so an empty key in an unselected block is fine). To change how documents are vectorized, change only this
# line. The backend container reads this whole file (env_file) and resolves <NAME>__<VAR> -> <VAR> itself, so a profile
# wins over the plain variables and over docker-compose.yml's defaults. One-off: EMBEDDING_PROFILE=api docker compose ...
#   local   the AI worker on the Docker host (MLX needs Apple Silicon, so it runs natively, NOT in Docker): private, free
#   pc      the AI worker on another machine (e.g. an NVIDIA GPU PC): private, fast
#   api     a hosted OpenAI-compatible API (OpenRouter), no worker needed: the TEXT of documents and search queries
#           LEAVES YOUR MACHINE (README "Using a hosted embedding API")
# Switching between profiles with DIFFERENT MODELS (local/pc: Qwen3-Embedding-4B, api: the 8B model) changes the vector
# space: the backend logs a mismatch warning and admins see a banner until the documents are re-embedded
# (README "Switching embedding models": npm run backfill:embeddings -- --reembed-mismatched). Profiles with the same
# model (local <-> pc) switch freely. Same rules and the full comments in socud-backend/.env.example; the native
# backend and ./dev.sh read socud-backend/.env, not this file.
EMBEDDING_PROFILE=local

# local: containers reach the host's worker at host.docker.internal (127.0.0.1 would be the container itself).
# Keep the worker on HOST=127.0.0.1 (verified with OrbStack).
LOCAL__EMBEDDING_PROVIDER=worker
LOCAL__AI_WORKER_URL=http://host.docker.internal:8000
LOCAL__EMBED_BATCH_SIZE=1
LOCAL__EMBED_CONCURRENCY=1
LOCAL__EMBED_TIMEOUT_MS=180000

# pc: replace the address; the token must equal the worker's WORKER_TOKEN (generate: openssl rand -hex 32).
# README "Running the worker on another machine". Alternative without a worker: an OpenAI-compatible server (LM Studio)
# on the PC as its own profile with PROVIDER=api and a private-LAN http URL (example in socud-backend/.env.example).
PC__EMBEDDING_PROVIDER=worker
PC__AI_WORKER_URL=http://192.168.1.50:8000
PC__AI_WORKER_TOKEN=
PC__EMBED_BATCH_SIZE=1
PC__EMBED_CONCURRENCY=2
PC__EMBED_TIMEOUT_MS=180000

# api: OpenRouter. Key: https://openrouter.ai/keys. PROVIDER_ROUTING (a JSON object, single-quoted) picks the fastest
# upstream host (without it OpenRouter may route to a slow one, ~7 s vs ~0.6 s); TIMEOUT 30 s so a hung request does not
# hold a job for 180 s.
API__EMBEDDING_PROVIDER=api
API__EMBEDDING_API_URL=https://openrouter.ai/api/v1
API__EMBEDDING_API_KEY=
API__EMBEDDING_API_MODEL=qwen/qwen3-embedding-8b
API__EMBEDDING_API_DIMENSIONS=1024
API__EMBED_TIMEOUT_MS=30000
API__EMBED_CONCURRENCY=4
API__EMBEDDING_API_PROVIDER_ROUTING='{"sort":"latency"}'
# SEARCH_MIN_SIMILARITY 0.35 was calibrated on Qwen3-Embedding-4B; tune it for the 8B model here if needed:
# API__SEARCH_MIN_SIMILARITY=0.35

# Settings every profile shares (a <NAME>__ prefix makes any EMBEDDING_*/EMBED_* variable per profile, see
# socud-backend/.env.example for the full list):
# EMBEDDING_DIM=1024

# Logging and error reporting (optional). LOG_LEVEL: fatal|error|warn|info|debug|trace|silent.
# LOG_LEVEL=info
# SENTRY_DSN=

# URLs the BROWSER uses to reach the backend. Inlined into the frontend bundle at build time:
# rebuild the frontend image (`docker compose --profile app build frontend`) after changing them.
# NEXT_PUBLIC_API_URL=http://localhost:3000
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:3002
# CORS_ORIGIN=http://localhost:3001

# Host ports (all bound to 127.0.0.1). Change if a port is taken; keep NEXT_PUBLIC_*/CORS_ORIGIN in sync.
# POSTGRES_HOST_PORT=5432
# BACKEND_HOST_PORT=3000
# BACKEND_WS_HOST_PORT=3002
# FRONTEND_HOST_PORT=3001
# POSTGRES_CONTAINER_NAME=socud_postgres
# Node major version for the images (keep equal to .nvmrc).
# NODE_VERSION=22
