# SOCUD AI worker settings. Copy to .env to override (optional: all values below are the defaults).
# Not needed at all when the backend uses a hosted embedding API (EMBEDDING_PROVIDER=api in socud-backend/.env).
# Names are case-insensitive (pydantic-settings), so MODEL_NAME maps to Settings.model_name.
# Two backends, same API and same preprocessing: MLX (Apple Silicon, native, never in Docker) and PyTorch (CUDA/MPS/CPU),
# which lets the worker run on another machine, e.g. a PC with an NVIDIA GPU. See README "Running the worker on another machine".

# mlx | torch | openai | auto (default: mlx on an Apple Silicon Mac, torch elsewhere).
# openai = no local model: embeddings come from an OpenAI-compatible /v1/embeddings server on other hardware
# (LM Studio, vLLM, Ollama ...) serving Qwen3-Embedding-4B. Needs REMOTE_URL; cleaning, query instruction and
# 1024-dim truncation still happen in this worker.
BACKEND=auto
# REMOTE_URL=http://192.168.1.50:1234/v1
# REMOTE_API_KEY=
# REMOTE_TIMEOUT=120
# Requests forwarded to the server at once. 2 is the measured optimum for one GPU (RTX 4070: 8 -> 11 texts/s);
# more only queues on the GPU. Tune with scripts/stress_test.py.
# REMOTE_CONCURRENCY=2

# Torch backend only: cuda | mps | cpu | auto (cuda, then mps, then cpu). An explicit device that is unavailable is an
# error, not a silent fallback to the (very slow) CPU. /health reports the device in use.
DEVICE=auto

# Hugging Face checkpoint, downloaded on first start. Unset = the default of the backend:
#   mlx:   mlx-community/Qwen3-Embedding-4B-4bit-DWQ  (~2.3 GB)
#   torch: Qwen/Qwen3-Embedding-4B                    (~8 GB, bf16)
#   openai: text-embedding-qwen3-embedding-4b         (model id sent to the remote server; see GET /v1/models)
# MODEL_NAME=

# Output dimension: embeddings are Matryoshka-truncated to the first N components and L2-renormalised.
# The backend's pgvector column is vector(1024); change both together (needs a migration + re-embedding).
EMBEDDING_DIM=1024

# Texts longer than this many tokens are truncated (the end-of-text token is always kept), never rejected.
MAX_TOKENS=8192

# Task instruction put in front of QUERIES only ("Instruct: {task}\nQuery:{text}"). Documents get none.
# Changing it changes the query embedding space slightly; keep it fixed once documents are indexed.
QUERY_INSTRUCTION=Given a search query, retrieve relevant passages from a knowledge base that answer the query

# Maximum number of texts accepted per /embed request
MAX_BATCH_SIZE=32

# Maximum characters per text (longer texts get HTTP 422)
MAX_TEXT_LENGTH=32000

# Compute dtype: float16 | bfloat16 | float32. Unset = float16 on mlx (faster on M1), bfloat16 on CUDA (the checkpoint's
# own dtype, native on RTX 30/40 GPUs), float16 on MPS, float32 on CPU.
# DTYPE=

# A forward pass holds at most INFERENCE_BATCH_SIZE texts and at most INFERENCE_TOKEN_BUDGET padded tokens
# (batch size x longest text). Defaults: 16384 for mlx (tuned on an M1 with 16 GB), 8192 for torch (a 12 GB GPU holds
# ~8 GB of weights plus activations; on CUDA an out-of-memory batch is split in two automatically). Lower it if memory is tight.
INFERENCE_BATCH_SIZE=8
# INFERENCE_TOKEN_BUDGET=

# Address and port uvicorn binds to. Defaults to loopback. To serve another machine (a remote GPU worker) use 0.0.0.0
# or the LAN IP: the worker then REFUSES TO START without WORKER_TOKEN. Also restrict port 8000 to the backend's IP
# in the firewall; the traffic is plain HTTP (use a VPN/trusted LAN or a TLS reverse proxy).
# Containers reach it via http://host.docker.internal:8000; verified to work with the default loopback bind on
# OrbStack. Other Docker runtimes may need HOST=0.0.0.0 (unverified): then also set WORKER_TOKEN and a firewall.
# In the Docker image (Dockerfile, compose profile `worker`) HOST is 0.0.0.0 and WORKER_TOKEN is required; compose sets both.
HOST=127.0.0.1
PORT=8000

# Optional shared secret. When set, POST /embed requires the header "X-Worker-Token: <value>" (else 401);
# /health stays open. Set the same value as AI_WORKER_TOKEN in the backend. Generate: openssl rand -hex 32
# WORKER_TOKEN=
