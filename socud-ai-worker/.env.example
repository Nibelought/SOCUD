# SOCUD AI worker settings. Copy to .env to override (optional: all values below are the defaults).
# Names are case-insensitive (pydantic-settings), so MODEL_NAME maps to Settings.model_name.

# Sentence-transformers model (768-dim). Downloaded on first start (~1 GB).
# The backend's pgvector column expects 768 dimensions; do not change without a migration.
MODEL_NAME=intfloat/multilingual-e5-base

# Maximum number of texts accepted per /embed request
MAX_BATCH_SIZE=32

# Maximum characters per text
MAX_TEXT_LENGTH=15000

# Batch size used internally for model inference
INFERENCE_BATCH_SIZE=16

# Address and port uvicorn binds to
HOST=0.0.0.0
PORT=8000
