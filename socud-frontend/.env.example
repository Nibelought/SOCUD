# NOTE: NEXT_PUBLIC_* values are inlined into the bundle at build time.
# Rebuild (`npm run build`) after changing them; restart `npm run dev` in development.

# Base URL of the SOCUD backend REST API (no trailing slash needed).
NEXT_PUBLIC_API_URL=http://localhost:3000

# WebSocket URL of the Hocuspocus collaboration server.
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:3002

# Runtime only (read by src/proxy.ts, not inlined): set to "off" to disable the session redirects
# (signed-out visitors -> /login, signed-in users away from /login). Needed only if the web app cannot
# see the API's `socud_session` hint cookie, e.g. unrelated domains. See README "Sessions and route protection".
# SESSION_REDIRECTS=off
