generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector, pg_trgm]
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String

  isSystemAdmin Boolean @default(false)

  spaceMembers    SpaceMember[]
  documentMembers DocumentMember[]

  documentsAuthored Document[] @relation("DocumentAuthor")
  documentsUpdated  Document[] @relation("DocumentUpdater")
  documentVersions  DocumentVersion[]

  refreshTokens RefreshToken[]
}

// Opaque, rotating refresh tokens. Only the SHA-256 hash of the raw token is stored.
// All tokens descended from one login share a familyId so reuse can revoke the whole chain.
model RefreshToken {
  id               String    @id @default(uuid())
  userId           String
  tokenHash        String    @unique
  familyId         String
  expiresAt        DateTime
  // Absolute cap for the whole family (copied to every successor), set at login.
  sessionExpiresAt DateTime
  // Set when the token was exchanged for a successor. Re-presenting it within a short
  // grace window is a concurrent refresh (e.g. two tabs); later it counts as reuse.
  rotatedAt        DateTime?
  // Set only on logout / reuse detection (family revocation).
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Space {
  id          String  @id @default(uuid())
  name        String
  description String?

  isArchived Boolean   @default(false)
  archivedAt DateTime?

  members   SpaceMember[]
  documents Document[]
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

model SpaceMember {
  userId  String
  spaceId String
  role    Role

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([userId, spaceId])
  @@index([userId])
}

model DocumentMember {
  userId     String
  documentId String
  role       Role

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([userId, documentId])
  @@index([documentId])
}

model Document {
  id          String  @id @default(uuid())
  spaceId     String
  parentId    String?
  title       String
  // Published content: frozen by Publish, what viewers and search see.
  contentHtml String?
  yjsState    Bytes?
  // Draft projection of yjsState (sanitized HTML / plain text), refreshed by Hocuspocus onStoreDocument.
  draftHtml   String?
  draftText   String?
  // Number of the last Publish (0 = never published through the versioned flow).
  publishedVersion Int  @default(0)
  // publishedVersion whose chunks are fully embedded; NULL = never. Drives idempotent backfill.
  embeddedVersion  Int?

  createdBy String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isArchived Boolean   @default(false)
  archivedAt DateTime?

  space   Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  author  User      @relation("DocumentAuthor", fields: [createdBy], references: [id])
  updater User?     @relation("DocumentUpdater", fields: [updatedBy], references: [id])
  parent  Document? @relation("DocumentHierarchy", fields: [parentId], references: [id])

  children Document[]       @relation("DocumentHierarchy")
  members  DocumentMember[]
  chunks   DocumentChunk[]
  versions DocumentVersion[]

  sourceLinks DocumentLink[] @relation("SourceLinks")
  targetLinks DocumentLink[] @relation("TargetLinks")

  // GENERATED ALWAYS AS (setweight(to_tsvector('russian', title), 'A')) STORED, see migration
  // 20261111090000_search_fts_trgm. Never written by the client (the @default only mirrors the
  // generation expression so that `prisma migrate dev` sees no drift). Published body text is
  // searched through DocumentChunk.searchVector.
  searchVector Unsupported("tsvector")? @default(dbgenerated("setweight(to_tsvector('russian'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\")"))

  // IDOR
  @@index([spaceId])
  @@index([parentId])
  @@index([isArchived])
  // Full-text search over titles and trigram similarity (typos, partial words) over titles.
  @@index([searchVector], type: Gin, map: "Document_searchVector_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Document_title_trgm_idx")
}

model DocumentChunk {
  id          String @id @default(uuid())
  documentId  String
  chunkIndex  Int    @default(0)
  textContent String

  // NULL until the embed-document job has stored the vector (Qwen3-Embedding, 1024 dims).
  embedding Unsupported("vector(1024)")?

  // GENERATED ALWAYS AS (setweight(to_tsvector('russian', "textContent"), 'B')) STORED, see
  // migration 20261111090000_search_fts_trgm. Never written by the client (see Document.searchVector).
  searchVector Unsupported("tsvector")? @default(dbgenerated("setweight(to_tsvector('russian'::regconfig, COALESCE(\"textContent\", ''::text)), 'B'::\"char\")"))

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // HNSW
  // vector_cosine_ops
  @@index([embedding], map: "DocumentChunk_embedding_hnsw_idx")
  @@index([documentId])
  @@index([searchVector], type: Gin, map: "DocumentChunk_searchVector_idx")
}

// Immutable snapshot taken by Publish.
model DocumentVersion {
  id          String   @id @default(uuid())
  documentId  String
  version     Int
  title       String
  contentHtml String
  yjsState    Bytes?
  createdBy   String
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [createdBy], references: [id])

  @@unique([documentId, version])
  @@index([documentId, createdAt])
}

model DocumentLink {
  sourceDocId String
  targetDocId String

  sourceDoc Document @relation("SourceLinks", fields: [sourceDocId], references: [id], onDelete: Cascade)
  targetDoc Document @relation("TargetLinks", fields: [targetDocId], references: [id], onDelete: Cascade)

  @@id([sourceDocId, targetDocId])
  @@index([targetDocId]) // Quick search for incoming graph
}
