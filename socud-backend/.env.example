# Copy to .env and adjust. Never commit .env (it is git-ignored).

# PostgreSQL connection string (matches docker-compose.yml at the repo root). Required.
DATABASE_URL=postgresql://dbsocud:check-socud@localhost:5432/socud_db

# Secret for signing access tokens, min 32 chars. Generate: openssl rand -hex 32. Required.
JWT_SECRET=replace-me-with-output-of-openssl-rand-hex-32

# HTTP API port (optional, default 3000).
PORT=3000

# Hocuspocus WebSocket port (optional, default 3002).
WS_PORT=3002

# ---- How embeddings are made: ONE switch --------------------------------------------------------------------------
# EMBEDDING_PROFILE picks one of the blocks below; to change the method (this machine / a PC on the LAN / a hosted
# API) change only this line (`./dev.sh restart` or restart the backend). Every block is complete and sits here at
# once; only the selected one is read, the others are ignored (an empty API key of an unselected block is fine).
#   local   the AI worker on this machine (MLX on Apple Silicon): private, free, slowest
#   pc      the AI worker on another machine of your network (e.g. an NVIDIA GPU PC): private, fast
#   api     a hosted OpenAI-compatible API (OpenRouter): fastest to set up, the TEXT of documents and search queries
#           LEAVES YOUR MACHINE
# Rules: <NAME>__<VAR> (profile name upper-cased, "-" becomes "_", two underscores) replaces the plain <VAR> while that
# profile is active, also if the plain one is set or empty. Allowed <VAR>s: EMBEDDING_*, EMBED_*, AI_WORKER_URL,
# AI_WORKER_TOKEN, SEARCH_MIN_SIMILARITY; anything else, or a profile with no variables, is a startup error that lists
# the profiles found. Add your own profile by copying a block (EMBEDDING_PROFILE=nas -> NAS__EMBEDDING_PROVIDER=...).
# Plain EMBEDDING_PROVIDER / AI_WORKER_URL / ... still work when EMBEDDING_PROFILE is unset (the old way, unchanged).
# A one-off override without editing this file:  EMBEDDING_PROFILE=api ./dev.sh restart   (the environment wins).
#
# Changing between profiles that use DIFFERENT MODELS (local and pc: Qwen3-Embedding-4B; api: the 8B model) changes the
# vector space of new text. The backend then logs a mismatch warning at startup and admins see a banner (GET
# /admin/embedding-status); search keeps working but mixes spaces until you run
#   npm run backfill:embeddings -- --reembed-mismatched        (add --inline to run without Redis)
# Profiles that use the same model (local <-> pc) switch freely, no re-embedding.
EMBEDDING_PROFILE=local

# -- local: the worker started by ./dev.sh on this machine (loopback URL). Qwen3-Embedding-4B, 1024 dims.
# Batch 1 is fastest to answer a search while documents embed (the MLX worker is compute-bound: ~2.2 s per full chunk
# on an M1, bigger batches are not faster); the long timeout covers a first-run model load.
LOCAL__EMBEDDING_PROVIDER=worker
LOCAL__AI_WORKER_URL=http://127.0.0.1:8000
LOCAL__EMBED_BATCH_SIZE=1
LOCAL__EMBED_CONCURRENCY=1
LOCAL__EMBED_TIMEOUT_MS=180000

# -- pc: the AI worker on another machine (README "Running the worker on another machine"). Same model as local.
# ./dev.sh starts no worker for it and `./dev.sh status` shows whether its /health answers. Replace the address and the
# token (must equal the worker's WORKER_TOKEN; generate: openssl rand -hex 32). Measured on an RTX 4070: batch 1 with
# 2 jobs at once overlaps the GPU's gaps (8 -> 11 texts/s) without hurting search latency.
# Alternative with no worker anywhere: run an OpenAI-compatible server on the PC (e.g. LM Studio, serving
# Qwen3-Embedding-4B) and use it as a "api" profile with a private-LAN http URL, e.g.
#   EMBEDDING_PROFILE=lmstudio
#   LMSTUDIO__EMBEDDING_PROVIDER=api
#   LMSTUDIO__EMBEDDING_API_URL=http://192.168.1.50:1234/v1      (http is accepted for private addresses)
#   LMSTUDIO__EMBEDDING_API_KEY=lm-studio                         (any non-empty text if the server has no auth)
#   LMSTUDIO__EMBEDDING_API_MODEL=<the model id LM Studio lists>
#   LMSTUDIO__EMBEDDING_MODEL_ID=qwen3-embedding-4b@1024          (only if it really is the same space as local)
PC__EMBEDDING_PROVIDER=worker
PC__AI_WORKER_URL=http://192.168.1.50:8000
PC__AI_WORKER_TOKEN=
PC__EMBED_BATCH_SIZE=1
PC__EMBED_CONCURRENCY=2
PC__EMBED_TIMEOUT_MS=180000

# -- api: OpenRouter (README "Using a hosted embedding API"). Key: https://openrouter.ai/keys (a secret: never commit it).
# The 8B model is a different vector space than local/pc (see the note above). DIMENSIONS=1024 asks the API for exactly
# the size the database column holds. TIMEOUT 30 s: a hosted request that hangs would otherwise block a job for 180 s
# (it is retried). PROVIDER_ROUTING is sent as the request's `provider` field: OpenRouter spreads a model over several
# upstream hosts and the default pick can be 5x slower (measured median 7 s via DeepInfra vs 1.3 s via Nebius;
# {"sort":"latency"} gave 0.6 s). Other values: {"ignore":["DeepInfra"]}, {"order":["Nebius"]}; remove the line for
# OpenRouter's default routing (it must be a JSON object; non-OpenRouter servers do not know the field).
API__EMBEDDING_PROVIDER=api
API__EMBEDDING_API_URL=https://openrouter.ai/api/v1
API__EMBEDDING_API_KEY=
API__EMBEDDING_API_MODEL=qwen/qwen3-embedding-8b
API__EMBEDDING_API_DIMENSIONS=1024
API__EMBED_TIMEOUT_MS=30000
API__EMBED_CONCURRENCY=4
API__EMBEDDING_API_PROVIDER_ROUTING='{"sort":"latency"}'
# Similarity floor (below, "Search"): 0.35 was calibrated on Qwen3-Embedding-4B; the 8B model scores differently, so
# check a few searches and tune it here for this profile only, e.g.:
# API__SEARCH_MIN_SIMILARITY=0.35

# -- Other settings that can go in a profile (prefix them with <NAME>__) or stay plain for all profiles:
# EMBEDDING_API_BATCH_SIZE   max inputs per HTTP request (provider api, default 32); EMBED_BATCH_SIZE is capped by it.
# EMBEDDING_API_QUERY_INSTRUCTION  task text of the Qwen3 query prefix "Instruct: <task>\nQuery:<query>". Default: the
#                            worker's text, only for model ids containing "qwen3-embedding"; "off" disables it.
# EMBEDDING_MODEL_ID         name of the vector space written next to each stored vector. Default: worker =
#                            qwen3-embedding-4b@<dim>, api = <EMBEDDING_API_MODEL>@<dim> (lower-case). Set it to
#                            qwen3-embedding-4b@1024 only after checking that a hosted model really produces the same
#                            space as the local worker (README, "Same space as the local worker?").
# EMBEDDING_API_REFERER / EMBEDDING_API_TITLE   OpenRouter attribution headers (optional).
# EMBED_QUERY_TIMEOUT_MS     timeout in ms of a search-query embedding (default 10000; on timeout search uses keyword
#                            hits only).
# EMBEDDING_DIM              vector size (default 1024); must match the DB column vector(1024).
# EMBED_BATCH_SIZE           chunks per request: default 1 for the worker (max 32), 16 for the api provider.
# EMBED_CONCURRENCY          parallel embedding jobs per process (default 1, max 16). With api 2-4 is good; a rate
#                            limit (HTTP 429) is retried automatically, lower it if you see many.
# EMBED_TIMEOUT_MS           timeout in ms of one document embedding call (default 180000). The MLX worker needs
#                            ~2.2-2.7 s per full Russian chunk on an M1; keep this well above EMBED_BATCH_SIZE x 3 s.

# Redis for the BullMQ embedding queue (optional, default redis://127.0.0.1:6379; in docker compose: redis://redis:6379).
# Publish keeps working without Redis; embedding jobs are picked up again once it is back.
# REDIS_URL=redis://127.0.0.1:6379

# Search: semantic hits with a cosine similarity below this are dropped (optional, default 0.35, range -1..1).
# Without a floor the nearest chunks are returned even when nothing is relevant. Calibrated with Qwen3-Embedding-4B:
# relevant best chunks score 0.44-0.78, queries with no relevant document peak at 0.13-0.39. Raise towards 0.40 to
# return fewer weak hits, lower it if relevant paraphrase hits go missing.
# SEARCH_MIN_SIMILARITY=0.35

# Queue switches (optional; default on, but off when NODE_ENV=test): QUEUE_ENABLED turns the whole queue on/off,
# QUEUE_WORKER_ENABLED=false makes this process only enqueue (no consumer).
# QUEUE_ENABLED=true
# QUEUE_WORKER_ENABLED=true

# Interval in ms of the safety-net scan that re-enqueues documents with missing embeddings (optional,
# default 600000 = 10 min; 0 disables). The first scan runs ~10 s after start.
# EMBED_RECONCILE_INTERVAL_MS=600000

# Swagger UI (/api/docs) and OpenAPI JSON (/api/docs-json). Optional: unset = on in development/test, off when NODE_ENV=production.
# SWAGGER_ENABLED=true

# Optional Domain of the non-sensitive `socud_session` hint cookie that the web app's proxy reads to redirect
# signed-out users to /login. Only needed when web and API are on different subdomains (e.g. .example.com);
# leave unset for localhost / same host. The hint carries no credentials; the API still enforces auth.
# SESSION_COOKIE_DOMAIN=

# Minimum interval in ms between access re-checks of one open Hocuspocus connection (optional, default 15000).
# Revoked or archived documents are closed within about this time. Positive integer.
# ACCESS_RECHECK_MS=15000

# Debounce in ms before Hocuspocus saves a changed document to the database (optional, default 2000). Positive integer.
# WS_STORE_DEBOUNCE_MS=2000

# pino log level: fatal | error | warn | info | debug | trace | silent
# (optional, default info in production, debug in development, silent in tests).
# Logs are JSON; they are pretty-printed only when NODE_ENV=development. Credentials are redacted.
# LOG_LEVEL=info

# Sentry error reporting. Enabled only when SENTRY_DSN is set; no PII, cookies, headers or bodies are sent.
# SENTRY_DSN=
# Fraction (0..1) of requests sampled for performance traces (optional, default 0 = off).
# SENTRY_TRACES_SAMPLE_RATE=0

# Seed script only (`npm run db:seed`): creates the first system admin. Password: >= 12 characters.
# Idempotent; an existing user with this email is promoted to admin without changing its password.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# Allowed CORS origin(s), comma-separated for several (optional, default http://localhost:3001).
CORS_ORIGIN=http://localhost:3001

# development | production | test (optional, default development).
NODE_ENV=development
