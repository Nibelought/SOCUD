# Copy to .env and adjust. Never commit .env (it is git-ignored).

# PostgreSQL connection string (matches docker-compose.yml at the repo root). Required.
DATABASE_URL=postgresql://dbsocud:check-socud@localhost:5432/socud_db

# Secret for signing access tokens, min 32 chars. Generate: openssl rand -hex 32. Required.
JWT_SECRET=replace-me-with-output-of-openssl-rand-hex-32

# HTTP API port (optional, default 3000).
PORT=3000

# Hocuspocus WebSocket port (optional, default 3002).
WS_PORT=3002

# ---- Where embeddings come from ---------------------------------------------------------------
# EMBEDDING_PROVIDER=worker (default): the SOCUD AI worker (AI_WORKER_URL below), MLX on the Mac or a GPU PC.
# EMBEDDING_PROVIDER=api: a hosted OpenAI-compatible embeddings API such as OpenRouter. The Python worker is then
# NOT needed (./dev.sh skips it). NOTE: the text of every document and search query is sent to that service.
# See README "Using a hosted embedding API (OpenRouter)".
# EMBEDDING_PROVIDER=worker

# provider=api only. Base URL; "/embeddings" is appended. Must be https:// unless the host is local/private
# (default https://openrouter.ai/api/v1).
# EMBEDDING_API_URL=https://openrouter.ai/api/v1
# Required with provider=api. Create one at https://openrouter.ai/keys. A secret: never commit it, never share it.
# EMBEDDING_API_KEY=
# Required with provider=api. Model id as the API lists it. qwen/qwen3-embedding-4b is the hosted twin of the local
# worker's model; openai/text-embedding-3-small is a cheap alternative (then re-embed everything, see README).
# EMBEDDING_API_MODEL=qwen/qwen3-embedding-4b
# Optional: send `dimensions` in the request (only for models that support it, e.g. Qwen3-Embedding, OpenAI
# text-embedding-3). Without it a longer vector is cut to EMBEDDING_DIM here (Matryoshka models only).
# EMBEDDING_API_DIMENSIONS=1024
# Max inputs per HTTP request (optional, default 32). EMBED_BATCH_SIZE (below) is capped by it.
# EMBEDDING_API_BATCH_SIZE=32
# Task text of the Qwen3 query prefix "Instruct: <task>\nQuery:<query>" (optional). Default: the same text the worker
# uses, applied only when the model id contains "qwen3-embedding"; "off" disables it; set it to use one with other models.
# EMBEDDING_API_QUERY_INSTRUCTION=
# Name of the vector space written next to each stored vector (optional). Default: worker = qwen3-embedding-4b@<dim>,
# api = <EMBEDDING_API_MODEL>@<dim> (lower-case). Set EMBEDDING_MODEL_ID=qwen3-embedding-4b@1024 only after you checked that
# the hosted model really produces the same space as your local worker (README, "Same space as the local worker?").
# EMBEDDING_MODEL_ID=
# OpenRouter attribution headers (optional): shown on openrouter.ai rankings.
# EMBEDDING_API_REFERER=
# EMBEDDING_API_TITLE=SOCUD

# Base URL of the AI worker, /embed is appended (optional, default http://127.0.0.1:8000).
# The worker may run on another machine, e.g. a PC with an NVIDIA GPU: AI_WORKER_URL=http://192.168.1.50:8000
# together with AI_WORKER_TOKEN below (see README "Running the worker on another machine").
AI_WORKER_URL=http://127.0.0.1:8000

# Shared secret sent to the AI worker as the X-Worker-Token header (optional, no default).
# Must match the worker's WORKER_TOKEN. Generate: openssl rand -hex 32.
# AI_WORKER_TOKEN=

# Redis for the BullMQ embedding queue (optional, default redis://127.0.0.1:6379; in docker compose: redis://redis:6379).
# Publish keeps working without Redis; embedding jobs are picked up again once it is back.
# REDIS_URL=redis://127.0.0.1:6379

# Vector size of the embedding model (optional, default 1024). Must match the DB column vector(1024).
# EMBEDDING_DIM=1024

# Timeout in ms of one document embedding call (worker /embed or API request) (optional, default 180000). The MLX
# worker needs ~1.2-1.6 ms per Russian character on an M1 (~2.2-2.7 s per full chunk); keep this well above
# EMBED_BATCH_SIZE x ~3 s.
# EMBED_TIMEOUT_MS=180000

# Timeout in ms of a search-query embedding call (optional, default 10000). On timeout, search uses keyword hits only.
# EMBED_QUERY_TIMEOUT_MS=10000

# Chunks per embedding request when embedding documents (optional). Default 1 for the worker (max 32); 16 for
# provider=api, where 16-32 is a good value (APIs are fast, one request per chunk wastes round trips; capped by
# EMBEDDING_API_BATCH_SIZE). The rest of this note is about the worker. Larger batches are not
# faster on MLX (on a GPU worker, 8-16 is a good value); small ones keep calls short and let search queries through between batches. Measured on an M1:
# a full 1800-char Russian chunk takes ~2.2 s, so a batch of 4 blocks the single-threaded worker for ~9 s and a
# search issued meanwhile usually misses its semantic budget (keyword/title hits only). Batch 1 measured
# at most 2.7 s for the query embedding, inside the 4 s semantic budget; throughput is the same, hence default 1.
# EMBED_BATCH_SIZE=1
#   With a remote GPU worker (BACKEND=openai on an RTX 4070) keep batch 1 and set EMBED_CONCURRENCY=2: two documents
#   embed at once, which overlaps the per-request gaps of the GPU (8 -> 11 texts/s) without hurting search latency.

# Search: semantic hits with a cosine similarity below this are dropped (optional, default 0.35, range -1..1).
# Without a floor the nearest chunks are returned even when nothing is relevant. Calibrated with Qwen3-Embedding-4B:
# relevant best chunks score 0.44-0.78, queries with no relevant document peak at 0.13-0.39. Raise towards 0.40 to
# return fewer weak hits, lower it if relevant paraphrase hits go missing.
# SEARCH_MIN_SIMILARITY=0.35

# Queue switches (optional; default on, but off when NODE_ENV=test): QUEUE_ENABLED turns the whole queue on/off,
# QUEUE_WORKER_ENABLED=false makes this process only enqueue (no consumer).
# QUEUE_ENABLED=true
# QUEUE_WORKER_ENABLED=true

# Parallel embedding jobs per process (optional, default 1, max 16). With provider=api 2-4 is a good value;
# a rate limit (HTTP 429) is retried automatically, lower it if you see many.
# EMBED_CONCURRENCY=1   (2 for a remote GPU worker, see EMBED_BATCH_SIZE)

# Interval in ms of the safety-net scan that re-enqueues documents with missing embeddings (optional,
# default 600000 = 10 min; 0 disables). The first scan runs ~10 s after start.
# EMBED_RECONCILE_INTERVAL_MS=600000

# Swagger UI (/api/docs) and OpenAPI JSON (/api/docs-json). Optional: unset = on in development/test, off when NODE_ENV=production.
# SWAGGER_ENABLED=true

# Optional Domain of the non-sensitive `socud_session` hint cookie that the web app's proxy reads to redirect
# signed-out users to /login. Only needed when web and API are on different subdomains (e.g. .example.com);
# leave unset for localhost / same host. The hint carries no credentials; the API still enforces auth.
# SESSION_COOKIE_DOMAIN=

# Minimum interval in ms between access re-checks of one open Hocuspocus connection (optional, default 15000).
# Revoked or archived documents are closed within about this time. Positive integer.
# ACCESS_RECHECK_MS=15000

# Debounce in ms before Hocuspocus saves a changed document to the database (optional, default 2000). Positive integer.
# WS_STORE_DEBOUNCE_MS=2000

# pino log level: fatal | error | warn | info | debug | trace | silent
# (optional, default info in production, debug in development, silent in tests).
# Logs are JSON; they are pretty-printed only when NODE_ENV=development. Credentials are redacted.
# LOG_LEVEL=info

# Sentry error reporting. Enabled only when SENTRY_DSN is set; no PII, cookies, headers or bodies are sent.
# SENTRY_DSN=
# Fraction (0..1) of requests sampled for performance traces (optional, default 0 = off).
# SENTRY_TRACES_SAMPLE_RATE=0

# Seed script only (`npm run db:seed`): creates the first system admin. Password: >= 12 characters.
# Idempotent; an existing user with this email is promoted to admin without changing its password.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# Allowed CORS origin(s), comma-separated for several (optional, default http://localhost:3001).
CORS_ORIGIN=http://localhost:3001

# development | production | test (optional, default development).
NODE_ENV=development
